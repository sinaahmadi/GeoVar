تۆ ئێستا
مراقیب
سەیری تەلەفزیۆنیش ئەکەم دڵت لە تەلەفزیۆنەکە پیسە
چۆن دەنگ ئەیەین بە شتی وا بابە، کورە ئەو هەر پیاو نیە
کورە ئەقڵ بێ ژنەکە
ئەرێ بەڕاست بۆچی خۆتان گۆڕیوە
کورە دایگرە، بابە دایگرە هێی وتارمان هاتووەو ئەوانە دایگرە
یاعنی ڕەنگەکەی تۆزێ تۆخ بێ سەوز بێتەوە
بێنە ، وەرە وەرە ، وەرە وەرە
ئینسان لە پێناوی قازانجی خۆیا هەموو شتێک ئەکا
ئێستا هاتووم بیبەمەوە لە چوێی یە
بەچی ناگەنەوە میستەر، خۆمان لەدوای دواوەین
ها ئەم ڕق و کیینەیە چییە ڕۆڵە ئێوە دوو بران بۆ ناسازێنن
مامۆستا ئێ، بەڕێزتان لەسەر یاساکانی هاتووچۆ ئەگەر شتێکتان هەبێ
دوو سێ خانووی هەیە ئەی دووهەمین
قوەتی هەر بۆ ئەچێ، میللەت قوەتی بۆ چییە
ئینجا پەو بۆی هەی بێ و من نەم بێت چۆن شتی وا ئەبێت
بەخوا وانییە، لەدڵەوە کوڵابوو بۆ عارف
هەتا وەکو ئەو خەڵکەی لەوێ، ئەو مەوزوعەیان کردبوو بە
پەیوەندی2، بە جەڕەسی مۆبایلەکە خەبەرم ئەبێتەوە
بۆی ئەکڕم تۆش بۆی نەکڕی لە تەقاعودیەکەی خۆم بۆی ئەکرم
کورە ئامۆژن گیان کابرایەک بوو ئیتر تەفسیری خەو و شتی وای ئەکرد
حەی هەرچی پەیایەکەم ئەیەیت بە جلی کوردی جوان و حەت حەتۆکە
ناهێڵی بەخوا ناهێڵی وەرە
بوراوەیی نیە باوکە
ئەوە ئیستا ئەزانی بۆچی هاتوون دائەنیشن ئەکڕوزێنەوانێ
بەس ئەزانی چی بێغیرەت ئائەوەیە
ئێستا ئا ئەوا ها تاقیکەرەوە بزانە چۆنە تاقیکەرەوە ئا دەی
کورە ساحێبی چێیە ڕۆستەم تازە هی من و هی تۆیە
ئەوە تەلەفۆنەکە
خواردن و شتی وا حازر
تۆ ئەو مەوزوعانە تۆزێ هینە با
تۆسەیریکە ئەوچاتر زۆرم پێخۆشە انشاءاللە لەوەخراپتر لێیە
ئێ ئەخر چۆنەبێ برا چۆنەبێ
دوو چاو بەقەربنە ژێرپیاڵەیەکە، نەوبینی
وایە ئینتەلا
تێمناگەیەنی کام قەسرە بەرزانە
هیوا1، بەقوربانت بم با من پرسارێک لە جەنابت بکەم ئێسا زەلام هەیە زەلام هەیە ئا ئێ ئێ
نزار دە باشە
باشە، ئاخر بۆ دیار نین بە ملی ورتان، لە چیۆن
هیچ نەبێ تۆزێ ئاوی نۆکێ
ئەڕۆی هەتا شەشی ئێوارە ئیشەکەی ها چیتەوێ وەرە سوار کۆڵمان بە دەی
سەبری گیان چۆنی
کەر مەبە
ها حەپۆل چییە ئەوە
بەرە وەاللە قوربان، بەڵام خوا ئاگایی لێیە
تۆ محاسەبەی من ئەکەی
بەرە والله
ئاخ ژنەکە چۆن پەنێکت بەمندا، ئەم سەیارە جوانەم فرۆشت و پارەکەشمان پووف
سەرگوڵ ئادەی ئێستا ئێوارە یاپراخێکی گەڵامێوم بۆ بکە
ئاخ ئەگەر ئەزانم لەکوێیە خۆم ئەزانم چی لێئەکەم
بەریە
نا، نا باشە بەسەر ئەو چاوانەم
بەس لە بیر نەچێ دوایی بچۆوە سەری
ئەی باوکە ڕۆ وەاللەی ئامۆزایەکم ئەمەنە وەزعی باش بوو
بابە گیان
بڕۆ لافیتەی بۆ بنوسە
بۆ نازانم میزەڵانی مناڵەکە بوو تەقی
سەیری ئەو قسمەت و نسیبە، وەرە تۆ لە بەڕازیلەوانێ
عەدلی و جوان و ڕێک و پێک بیخەمە بەر دەستان
بەخوا ئەیان کوژم عەزیتیان نابی
بەخوا حەقی خۆم و باوکمیان لێ ئەسەنم، من لێیخۆشنابم
قسە مەکە با، ئیسرەحەتی بکە دەی دە دانیشە دانیشە
ئێ ئا
باوەڕت هەبێ، ئەها بە چاوی تۆ، بە سەری تۆ، بە ڕۆحی تۆ
کورە کاکە من
لە چی ئەچم مامە
ناوی دایکیشمان زانی
ئەی ئێستا، ئێستا عەوداڵی چیت
ناوەڵا کاک تەیب گیان هیلاک نییە باوکم قەبزە ئەمەوێ دانیشێ
بە بەستراوی بەجێم نەهێشتووە، کە هاتمەوە کردمەوە
تۆ حیقایەتی ئەم کیسەڵەم بۆ بجێڕەڕەوە
باوەڕو قەناعەت بێ ئێستا شتێک پێ بڵێم لەوانەیە باوەڕ نەکەی
کە ناچین، لێرە خۆشە چینی ماچین
یەکسەر چوین کاستەریان دانا، شتیان دانا
ئەی تۆ بۆ ناچی
چونکم چڕ و چاو دیارە، ئەرە بە خوا
قاچیشم با جوان جوان پاکەمەوانێ، بەخوا وابزانم جەژن بوو خۆم شت
هیوا، کاک تەیموور خان لەسەر مەسەلەی
