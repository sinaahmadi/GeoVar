من مەکتەبم بۆ تەواو نەکرا
یەکتر ئەبین، ئەمە سەرکەوتنی ئێمەیە، ئیتر لەوەوە تەجاوزکا
ناو مەوزوعەوانێ ئێمە چۆن ژینگەکەمان بپارێزین
کەریم جیان، مۆلیدە مۆلیدە هەیە دەنگ نەیا بە مۆلیدە
ئەوەیان زۆرە نابێ وابڵێی ئێستە تۆ مەسەلەن قسەیەکی جوانی کرد
دوای سەعات چواریشەوە
ئێستا بۆت ئەکەمە ناو شوشەی زم زمی ئێرانیەوە
وەڵاهی ئینجا کاک عوسمان گیان نازانی نزیک بۆتەوە و
بەڵێ ڕێگە ئەیەین ببورە
بژی
ئێوە دوو بران، بۆ ناگونجێن بەیەکەوە
ڕاکەنە دەی دەی دەی
ئەم پارچە قوماشەی یا بەمن وتی بیکەن بە ماکسی و
بەیان خان بەیانی ئێستا لەقەبی کراتینت چۆن وەرگرت
دایکو باوکی سەربەرزی شەهیدان چاوەڕوانی پاداشتی
هەر مەکتەبی سیاسیە مێزی درێژی هەیە، ئەی چییە
بەیان، ئا ئا کاکی موزیع ئا ئەمە ئا ئەمە نە سەیرانێکمان پێ ئەکا نە بازاڕێکمان پێ ئەکا نە مۆبایلمان هەیە
خوێندنەوە، لام وایە ئەمڕۆ هەموو ماڵێک کتێبی تیایە، ئەم
ئم بەڵێ بەیان خان ببورە جەناب من کاتێک پەیوەندیم پێوە کردی وتت لەقەبەکەم بەیان زوڵف لولە
ئەمە شەش، ئەمە حەوت، ئەمە هەشت، ئەمە نۆ، ئەمە دە
ئەمە فێری قسە بووە نوری
ئەمە، ڕوئەسا قیسام هەمووی وەستاون
بەشکم گەردن ئازایی لە یەکتر بکەین و گەردنم ئازا کات
ئەی بەخێربێی
پرسیاری من وتی چی
ههههه ئەزانی گرێبەستەکە چۆنە نەک چوار پیاز یەک لەت نمێنێتەوە حیساب نییە
بەس مەسەلەن پێت بڵێن وەڵا ئێوە ئیسراحەتێ کەن مەسەلەن
ئەوە یەک، ئەمە دوو، ئەمە سێ، جارێ با سیان بێ بەڵێ
یەعنی تۆ لە شتە چاکەکانا نۆ دەقەکە
توخوا ئائەمە وەزعە ناو ئەم لەتوو پەتە
بە ساقەیبم دوور بینە دوربین
مەسەلە ئەو مێردەکەی بەکەڵکی یەت، ئەمیش یەعنی ئێ ئەم بە کەڵکی ئێ مێردەکەی یەت
ئەمە دیزاینەکەیە هی پڕۆژەکە
باشە ئاخر چۆن ئەمانە هەڵیەگرن لەکوێیا حەشاریەن
کەی بتەوێ ئەو لەتیفە شێتەو بە یەک دەقە بۆ دەس گیرەکا
ئەی وت نا ئادەی تڕخێنەیەکم بۆ لێنە، ئیتر
گوێم لێ بگرن، ئێستا ئەچینە فەلاقە خانەکە لەوێ مەعزەرەکە ئەنوسین
کورە حەیامان چووە لای ئاو دراوسێیانە
ئەرێ فریا نەکەوتم ئەوە تۆ چیتە
سۆسیال چیە
ئهێ خێر دەی بزانین ئەو خەوە موزعیدە چییە
ئەڵێن جەژنە جا خۆ کاکە گیان بەخوا خۆ من نە گوێم لە الڵە اکبر بووە
چی بیر بکەیتەوە بیر لە چی بکەیتەوە مردوو مرێ
چۆنی باوکم جۆبگرە
یەکێکیان ئەوەیە ئەڵێ ئائەم لەم بەینا نییە لەم بەینەی ئەخیرا
هەی بەقوربانی ناو دەمت بم باشە
کەوا ئەم پرۆسەیە ئەبینی بڕۆ ئەویش تاقیکەرەوە
باوڕکە
بامێ بامێ بەچاوی بەکر ئەیوت بە دە هەزار ئێ من لە چوێم بوو
کە خوا ناردی کەس پێ ناڵێ کوڕی چێی
نا نا ڕاسەکەی چییە دەڵی لە کەندیخانی،ئابێنە پارچەیەکم بەرێ
یا حسابی قازاجەکەی حانوت ئەکا
با لەت و پەتت نەکەم بڕۆ دەرەوە
قابیلە خۆ یەعنی نابێ یارمەتیان دەین
خوا بەقوربانوبم
ئا، ئێمە لە چ مەزەخێکاین، جەنابش دانیشوویتە
چوێ کورە
کاک حاکم، ئەرێوەڵا بۆخۆمان لەگەڵ سەفایا لە تەفریحین
ئاخر ئەی کەی
ئەی بە قوربانی ئەو دەمەو بم عەلی گیان
ئەیەڕۆ زەمبی چی، ئێوە ئی زەمن، بەخوا هەر ئەموت دیار نین گلەیم لێ ئەکردن
ئەی تۆ بۆ ئەیکەی
حەسەن ئەوە ئەوە پاشی
کاکە مەفڕووزە هەموو کەسێک لە کاری خۆیا
مێن
حەز بۆ جەزی خۆو چییە بەرەڵاییە شاری بێ حاکمە ها
نە نەوەڵا دەستت خۆشبێ
وەستا فازیڵ ئەوە شاگردی تازە بوو ئەم نموونە جوانە
کە ئێتە ئێرە بە جەنابتی وتبی وەڵا فڵان شتمان دۆزیوەتەوە
کامیل، هەر بەیانی زوو هەتا ئێوارە تاریک ئەبێ من لە شوێنی پەیکەرەکە
ئەرێ کاکە تەواو هاتوین ئێرەیە
کاک ڕەمزی، تکات لێ ئەکەم، تکات لێ ئەکەم خۆ و توڕە مەکە و
چارەکێک چاوەڕێ کردوە یەکسەر ئیستیقالە ئاکا
دەی، بەڵێ ئەیهێڵێ، دەی بۆ دەرەوە
بەخوا ئیتر ئەگەر ئیشیان پێم بێ بە جاری وایە شتێکم تێ ئەگرن
وەاللە دڵم خۆشە، ئارە وەاللە معاشم وەرگرت
تێگەشتی، دانیشە، کاچی من خەلکی دەولەمەن
ئێمە ئەبێ خەڵک ئاشتکەینەوە
چۆنی حاجی ژن، بەخێربێی، مناڵەکان چۆنن
وەڵاھ ئیتر بردم بۆ بازاڕ، بە سەری تۆ هەر بە
هەسە درەنگە دەی
بەوخوایە
هاتووە بۆ ئێرە، چووە بۆ ئەو صابون کەرانەی لای خۆمان
دە چی ئەکەی دە فەرموو دەی ئێستا
ئێ، کاکە هیوا ئەمانە لە دنیای بزنس تێناگەن
بەڵێ عارف گیان، ڕاستێکەی من هاتووم دوو ئامۆژگاریو بکەم
با یەک شت پێ بڵێم ئەساسی مرۆڤایەتی کە دینامیت و باروتی درووست کرد
تۆ ئەم کەرەو پێیە ئاوایێت و ئەرۆی بۆ پیاسەیەبەی
یەخوا باوانێ شێوێ ناو سک و دڵی منت خستە خوارەوە
چی لێیان قبوڵ نەکەم زلەیەکی لێئەیەی دەلێخاو
ئەوە مەوزوعێکی کە هەیە ئەڵێ
ئا تۆ بڵێ چیو لێ کراوە لەناو شارا
کورە چۆن نابێ جێی بێڵێ ئەسڵەن عەیب و داڕزینە جێی نەهێڵێ
ئەرێ وەڵاهی زۆر زۆر ڕاس ئەکا یاڕەبی
هەر بۆچیش بۆچیش وەریەگرم
ئەتەوێ ئاسک و کەو و کۆتر و ئەوانە ببێ بە نسیبی کش کش کش
ئەمانەوێ ئەمانەوێ باشە حەیامان مەبە ئەمانەوێ
نەوتی چیی
وەڵاهی نوری ڕاست ئەکەی ئەو سەباحە بە جدی، بە جدی
بزانە چۆنە
بەخیرهاتنی ئەو میوانە خۆشە ویستە ئەکەم
ئا تۆ هێواش
ئەشەو بالله
کامیل، ئاگات لێیە ئاگاو لێیە ئەها باسی ئەوە ئەکا ئەلێ من لەگەل فر ە ژنا نیم
کوڕە بێ مەعریفەت بێ مەعریفەت ئەوە مناڵێکە ئایا مناڵێک ئەوە ئەهێنێ تۆ بچی بە دەمانچە جوابی بەیتەوە
عەول، من پێشتر کە وتم ئەمەیان بۆ قەرزە و جاری وا هەیە بەڵام کابیا نییەتی لەو کاتەیا
من شەهادەم هەیە، وتی وەرە ئەوکەم پە ساێەق لای خۆم
زۆر زۆر طەبیعیە ئەواشتانە تۆ ئەبێ بڵێی نابێ بەو مۆدێلاتەیا بڕۆین
سالح، ئەمە بۆ ئەوە کراوە کە ئیشەکانت بۆ سەهل بێت
ماڵ ماڵی خۆمانە
کورە بووە بەقەرە بروت
ڕۆڵە شتێ کۆکەرەوە بیدە بە پارچەیە ئاڵتون، تێیەگەی
خوایە گیان چۆن تووش بوینە
کوا موبایلەکەم
نا نا پێم ناخۆش نییە، فەنتەڵۆس بێ دارۆغایەو
ئەی ئێمە ئەم لافو گەزازە بەچی لێئەیەین بابێتەوە، با بێتەوە
ئەوە باوکم، بە قەبری باوک
سەمەد، ئەها بزانە بێ مێشکێکی وەکو تۆ دڕکی پێکردووە، سکەی ئاسنمان نییە
ژن ئەهێنی حەفلە ئەکەی نابێ پێمان بڵەی
کامیل وەلای گوێ بگرە کاک فەرەیدوون کە من ئەو پارەیەم لێسەندیت جارێکی تر نەیەت بەلامدا بۆ شت ئاخر ئەوە حالەکەتە
بدەمێ بە گەردن ئازایی باشە برایی باوکم
سامان و ڕسقی هەیە بۆ ئەولاکانەتی
قەرەباڵخیە سەرەی بەنزین
لێرە ئیعتیماد ناکەنە سەر کارتی بایۆمەتری
ئەی ئافەرم ئەی ئەفەرم
قۆزی ، نیو قۆزی ، برزاو ، کەباب ، تکەی مریشک
وایە، ئەوە حەلی هەیە ئەمەش حەلی هەیە
بۆشی هەیە توڕە بێ، بۆشی هەیە توڕە بێ
هەڵیش نەبەزیتەوە دەی حەیامان چوو لە گەڕەکا
دانیشتووە لێرە موعەزەز و موکەرەم
قوربان جەنابی کاک فەهمی، ئەوەتانێ بە جوێی خۆت جوێو
ببورن پەیوەندیەکمان لەگەڵایە کاک قەرزاوی ئەبێ بمانبەخشی یەک دەقە
شێرە بەڕێزیش وەکو قسە کەری ئاژەلەکان لێمان زویر نەبوبێ لە قسەکانمان
کە لە ژێرمانەوە ئەڕوا یان
هادی، باشە جەنابت یاعنی ناکرێت مەسەلەن خەلکێک مۆبایل و فەیسبووک و ئەوانە بەکاردەهێن تۆش باێن تەرکی هەمووی بکەی چونکە ئیشت ناڕوا
دەی خوا بەخێری بگێڕێ دەهەستە دەی درەنگە بۆ دەوامەکەو
با ساحێب هینەکەش بێ، ساحێب ماڵەکە
هەشتاکان لایە ها کە لە مەحکەمە ڕەچەتەیەکی تەلەفون بۆ هاتەوە
تۆ کۆڵۆن بتەقێ ئەزانی چیو لێیە
ئارە وەاللە چۆڵە باوکم چۆن چۆڵ نابێ
ئامە لەگەڵ تۆمە جوابم بەرەوە جوابم نایەیتەوە باش جوابم مەیەرەوە ئامە
زلە دەرەقەتی ئەو ڕیش سپیە نایەی کە هەرجار جەڵدەی ڕەماغ لێ یاو لێ کوشت
دەسم خۆشبێ، ئەزانی بۆچی مارف
ئەرێ، ئەرێ ئەوە ئەو جرت و فرتەی لە چیە کەمال
بڕۆ هتد…
ماڵی چێمان دزی پیاومان کوشت
عارف گیان ئەمە بە بە من
ئیتر لەمەودوا تۆ عیلاقەو نییە، تێگەیشتی
کورینە بەحرە ئەم سیاسەتە بەحرە بەحر
ئێ کاکە هەموو کەس ئەزانێ مەسینە هی ئاودەستە ئەمە سلفە باوکی
سەلیم، نەفەوتێ ئێوە بتوانن بکەنە قەریەکی سینەمایی گەورە و کارە هونەریەکانتانی تیادا ئەنجام بدەن
جا بەرێزان من نامەوێ زۆر بچمە ناو، ئێ تەفاسیڵی ئەم هەموو عەیب و عەیبەکاریەوە، بۆ ئەم مەبەستە دوو میوانی زۆر بەڕێز و خۆشەویستم بانگ کردووە ئەوانیش هەردوو بەڕێز،جەنابی کاک عەبدی بێ عەیب، بەخێربێ سەرچاوم، ئێ هەروەها، جەنابی کاک سەردار سەردەمی، یاخوا بەخێربێ سەرچاوم
باشی شکور مامە ڕەزا
خۆو هەر شیرینی
دە باشە، زۆرچاکە، ئەو مەڕەی ئێوە ئەتانەوێ
ئەوەنەی پاڵپێوە ناوم وەڵاهی بووە بە شیشی کۆشت برژان
بۆ پارە سوتاوی فەرموو ئەوەش 6 هەزارەکەو
ئا، نانا ڕاکە بەدوای شاگردەکەتا
دە فەرموو دەی هاتووە بۆ خەریب ئەپاڕێتەوە
وەیش وەیش باوکە، وەیش و ئەوانە باوکە
ئاها گوێ بگرە، ئەرێ براژن
عەڕەب ڕمض النضال
سەمیرە ئەمهێنێتەوە
ئێستاکە، یەکەم سزامان ئەوەیە شتێکی بەسیتە سەت سەلک پیاز دەخۆی
فەرقی نیە سروە ئافەرم بیزەبت ئەمە وەکو کراسێک وایە کە من ئەینووسم
ئەمەوێ سەرێکی مدیر بەم ئیشم پێیەتی
عیلاقەی بە مەسایلی حدودی بەینی، عێراق و ئێرانەوە هەیە
سەلیم، ئاخر دە ناکڕێ ئەم خەڵکە بۆوا فێڕی ئەم پەیارەیە بووە
باوک هیلاکی چیت ئەی ئیشی ماڵ چییە
ئێسا یەک شەپۆلی بەقووەت بۆ نمونە ها
ئینجا بەڕێزان من پەیوەندی…
وزبە، جۆ بگرە
هیوا، هەموو مانگێ جارێ بەڵام دیارە ئەمە کولفەیەکی زۆر ئەبا
هەنلسەدانیش هەر ئێوە ئەمان دەنێ وانییە
ئیتر بۆخۆشم سەرۆکاریان ئەکەم و ئێواران کە یێنەوەیانێ ئادەی چیتان پەیا کردووە
کوڕی خۆم من قسەکەی تۆش بە تەواو ئەزانم
دێوی کاک عەلادینم، ئەمرکە کاک عەلادین بۆو تەنفیز کەم
ئەم بەیانییە هاتوون ئیتر دەفتەرمان داناوە، ئیتر خوا هەڵناگرێ
پارەش ئەنێرین بۆ ماڵی نێرگز تۆ هاقت نەبێت
لەم شارەولەو دێیە دەر بەدەریان بکەم
تو شەرەف مەحقولە تو شەرەف شوورەیی نییە وەرە کابرا خۆت و ژن و کوڕت بخەیتە سەرەی بەنزینەوانێ ئەخر تو شەرەفت ئا ئەمە چەندی بە چەند
نەم وت ئەحە، هەتا ماوی ئەبێ مەمنونی ئائەو میستەرە بی
ئا، لامە بەس، وەزنی چەن بێ چەن نەبێت
ئەم تڕخێنەیە ئیتر ئەبوو بە شروب و دەرزی و بڵێن بە کەپسول
هەر زۆر زۆر حەزم لێیەتی
یٔەرێ یٔەم عەولەمەیە چییە
وەڵاهی قەت لە باوکتی ڕەحمەتیتم نەبیستووە باسی دەست کەوانی کردبێ
ڕەنج بدەن و خزمەتی کەن، ئەمە فەڕزە فەرزی عەین
ەیوەندی، کاک بەلێ گیان
قوربان من چەن ساڵە خزمەتی تۆ ئەکەم
بەو قورعانە جەمال ئێستا ڕیخۆڵە و، ماعیدە و، هەمووی
ئینجا چیم لێکردوە ها پێم ناڵەی چیم لێکردوە
ئەی ئێمە
ئەی ئافەرم، ئەی ئافەرم ئەمە تەواوە
با لەگەڵ تۆیا بیکەین
عەبدول، بەشەرەفم ئەوە لەگەڵ ئێمەیەتی، جوێو لێبو وتی چی
ئەزانی چی بکە ئیشەڵا
فێری دراسەیی ئەبێ، دەرسی چاکی پێ بەڵێن
وەرە دەی وەرە، وەرە، وەرە
دەی باش
