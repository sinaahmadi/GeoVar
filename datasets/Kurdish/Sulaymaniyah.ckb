زۆر زۆر هاوکاری بووین زۆر مرۆڤێکی باش بووە لەگەڵ ئێمەیا
ئاخر وەرە وەرە
ئەخر بۆ هەر ئەبێ لە ئێمەوە بێ
ئەی ماڵت ئاوا بێ
ئەوە ئیتر نەعلی دڕاو و پاتەی لاستیک و سۆندە و
ئێ دە باشە مادەم درۆم لەگەڵ ناکەی
ئا توخوا حەمە عەلی ئەمەم بۆ بگۆڕە بە دانەیەکی کە بەقورعان تەواو پیای، لێی پەست بووم، هەر زۆر زۆر تەواو لێی پەست بووم
ئا، ئا خوا ڕسقت با، خوا حافیزت بێ
دانیشە، دانیشە بابە گیان دانیشە
لە پڕێکا خۆی کرد بە ژورێ
ئەرەوەڵڵا وەرمگرتۆتەوەو ئەشچم بۆ دەنگدان
ئای تڕحێوە
واز لەوەبێنە
خۆ ئەوە من نایڵبم، خەڵکیش وائەڵێ، وایە
گۆڕانی وتن
بەس ئەوە قبوڵکەم، کە وردە وردە پارەکە لەبەرەوە بتدەمێ ئەگینا
ڕاوە ماسی ئەکەن ئەوە لەو سەیرتر نییە
بە قەدی تۆ دووراوە، سەر زل، تۆ سەیری خۆتت کردووە جارێک هاتووی دانیشتووی ئەسڵەن ئووسوڵی
هی چی
با بە دەواری دۆمی نەکا، ئەمە یەک، و
بەڕاستی زوڵمم لێکراوە غەدرم لێکراوە وی وی
عەزابەکەی بەس بۆ من و تۆیە، ئەرکی ئێمە ئیتر زیا ئەکا
ماڵی پڕە لە ڕازیانە و کورەکە بە سک ئیشان ئەمرێ
قانون، قانون لەم وڵا، لەم مەملەکەتەیا، لەم مەملەکەتە
چنار کێییە
خۆش بی
ئای دنیا، بەخوا دنیایەکی سەیرە
خۆ ڕان بە دوو و ڕوبعێکە
ئیتر جوابەکەشمان بە سەریعی بەنەوانێ بۆ ئەوەی ئێمە بتوانین
خۆ گا جوت نیە تا ئەمرێ لە پێچێکا بمێنێتەوە ها
سەلەم و عەلەیکم باوە گیان، باوە بە قوربانت بم باوە گیان
من جارێ پێشەکی زۆر پشتگیری قسەکانی کاکە عەزە ئەکەم
نا ئێمە دروست ناکا
ئەمەوێ بزانم ئەم یاسایانە لە پەتریپۆتیشا کاری پێ ئەکرێت
من لەم بەینەیا
ئەنجا بەس نییە من قسەی زلم لێیێ
هەر ژورێک، ئا هەر ژورێک مەسەلە ئێستا
ئەی هەیش ئای عومەر باشە بیفرۆشە کاکە بیفرۆشە
کاک جەوهەر گیان، ئێمە لەم گوندەی خۆمانا جۆرەها زرعاتمان هەیە
ڕاست ئەفەرموی
بەڵێ، باش، باش
نەخێر، بانگ کراوین بۆ ئەو مەولوەی ئەوبەرەوە
ئێ خۆم یەکەم جارم نییە، خۆم شارەزام، خۆمە ڕۆم
هەستە هەستە درۆ بە دەمی منەوە مەکە بڕۆ ئەم مریشکانەم
ئێ دە کاکە حیسابەکەو غەڵەت کردووە برا
یەعنی دانومان بەیەکەوە ناکوڵی
یێ حەقە وەڵا یا حەقە مە ئیبادە ب
پیاوی1، ئا دوانزە نانم بەڕێ
دەی کەسی لێنەمێنێ پێتان ئەڵێم
سلفەی چی ئادەی چەنە ئادەی ئادەی
خوا خێرتان بنووسێ، ماڵتان ئاوا بێ
خوایا ئەمە ئەولایا ها
هاوتا بیگری هاوتا هاوتا بیگری حەمیقە
ئەوا چی ئەکەی غەنیە خائین چیەکەیت
ئەی یاخوا بەخێرووێی عومەر چۆنی ئەوە خێرە بۆکوێ ئەچی
هەنێ ئاسەواری هین مەدحەفەکەمانی نیشانبەین
باشە بە ساقەوبم
هەوڵ بەین حوکومڕانیەکی تەندروست بێتە ئاراوە و
ببورە وتم دەتوانم دوو دەقە لا کاتت بگرم
بە خوا پیاوەکە من هیچم
ئێ دە قسە بکە
خۆزگە منیش ئەبووم بە دایک
مەرجەعی زەهری مار
مەلا ئەحمەو
لە ئەوەڵی ساڵەوە تا ئێستا، سێ چوار جار گۆڕاوە
ئەما ئەم بەڕێزە هاتوە ئەم داماوە پێنج دانە ملیۆن دیناری
ماهیر، وەلای ئەشەو بیلا هەر زانیم وەڵامت
دوای ئەوە هەتا ئەمری ئەبێ هەوڵبەی
من ناوم حوسێنە
یان ناوت پلاسکۆ بووایە بۆ ئەوەی سێوی باشت تێکردایە
ئەرێ تۆ مرد و نەمرێ سەربان و دە قات و سێ قات و
ئیستیقالەی چ، تۆ باسی چی ئەکەی، تۆ سەیری کە
ئەگەر دەرەجاتی سەعی سەنەویم تەسلیمی ئیدارە نەکردایە
بەڵام ناکرێ و ئەگەر نا، بۆم ئەکەیت و جوابم لێ ئەجێڕیتەوە
ئێ والله یی وامزانی ئەڵێی باوکم مردووە
نەوەڵا نایلۆن نییە، ئەزانی چی، ئەو ڕەشە هینەکان نییە داماوەکان
باشە چۆن تەحەمولی کردووە تا ئێرە ڕەمت نەکردووە
لای بە ، لای بە
شتێکی ئاوا باشتر
ئەخر کاکە من تێناگەم، لەسەر چی داوا کراوم من
شەیتان بە نەعلەت بێ، ئیگینیا ئەو ناو چاوەو خوارەکەم
لایبە دەی
کوڕە بەسەرچاو ئەوەی کە تۆ داوات کردووە من بەزیاوە بۆت ئەکەم
یا خوا بێوەی بی، ئئئاوا لێمان ئەپرسیتەوانێ بێ قەزابی ئامۆزا
چی یە هەتیو خەریکە لێمان هەڵەگێریتەوە
تاقەتم نییە
تۆ نەک داخرێ تەوە نەک داخرێتەوە شەبەکەم کەم پێیە
بۆ خۆمان قوڕ و قەپ لێی دانیشین نابێ نا
باسە قانونی ژنان بۆ مەکە
باشە، قسە مەکە
کورە سەلام گیان، شەرمن گیان ئێوە باسی چی ئەکەن بەقوربانتان بم ئەوروپای چی و خاریجی چی و دەرەوەی چی، بابە گیان ئەم دوو کوڕەی من لە قاتی سەرەوەن، ئەوە چەند وەختە چاوم پێیان نەکەوتووە بەساقەتانبم، لەسەرەوانێ ئیتر ئەمە خەریکی فەیس بووک و ئەنتەرنێت و ئەمەن بیست و چوار سەعاتە، من شەو یێمەوە ئەمانە خەوتوون، بەیانیان کە ئەرۆم ئەمانە هەر هەڵنەستاون لە خەو، بەقوربانتانبم ئەمانە هەر خەریکی ئەم بەزم و ڕەزمەم هەتا ئێستا چەند وەختە چاوم پێیان نەکەوتووە
ئەی بۆ لای ئێمە ئەی وت ئەوەنە ئیسهالم ئەوەنە ئیسهالم فریای ئاب خانە ناکەوم
ئەلین لە هۆلەندا هەیە
هەتا ماوین لە ژیانا لوقمەی حەڵاڵمان پێشکەشکەیت و
ئیشم پێیەتی
تێئەگەی شتەکان بە مەزبووتی ئەکا
سەت لە سەت نەجاحەت ئەهێنم
ئەوە ئیلاقەی بە سیاسەتی دەوڵتەوە هەیە
ئەی چیی بوو
حەمە گیان
ئیجا قاسم واز لەوانە بێنە، تێئەگەی
کورە بێقەزابی یاخوا، کەسێ ئەگەر شیری پاکبێ و دڵ حسبە دڵ
بابمی لێ یە
قەی چییەکە ئاشت بەرەوە لە گەڵیا
لە دانیشگەیە بە گاڵتە بەخێو ئەکرێن
ببەستی بە قاپێ خەنەوە
والله لە ساحێبی ئەم ماڵە
تەبعەن فەرمان ئیشی منە
ئەی ئەمانە دەلیل نییە ئینجا مانگیش هەر سەر لە ئێوارە دیارە قوربان
شەڕ نەبووە
من شەخسی خۆم درۆ ناکەم لەبەرئەوە
بە زایە ناچێ بۆ ئەو دنیاتان باشە
بۆ خۆ شکور خۆشمان پیاومان زۆرە
ئا بێنە تۆ بێنە با سەیری کەین، کورە دە دەسی پیاکە، دەسی پیاکە
بە دەرگایەکی گەراجییەوە نەئەچوو
چۆن جێبەجێی ناکەم بە قوربانم، من چۆن دڵی تۆم پێئەشکێ
باشە باش باشە کاک هیوا کاک هیوا با پرسیارێکی لێ بکەم
کەرەکەم بۆ کەرەکەم چیەتی
کورە عەیبە توخوا
وەاللەیی کاک مەعروف، من ئیلاقەی ئەم مەسەلەیەم نییە
ئەشەو بیلا تۆڵەگەی ناگاتێ ئاغا
سەلام و عەلێکوم وەستا
ئیتر ئەوانیش چەتری خۆیان بۆ خۆیان
ئێ قەینا تۆ بە هەڵا هەڵا
کورە من ئەڵێم ئاومان نیییە لە ماڵەوە
بەڵێ بە جدیمە
هەلپە، بەو قورئانە گوێ بگرن بە (لا الا اللە) چۆن پیاوێک چۆن پیاوێک پێ ناخۆشە ژنەکەی خیانەتی لێ
ئەرێ بابە من خەوم بینیوە یا ئەمە ئاخر زەمانە بۆ خاتری خوا
ڕێبوار
ئەک باوکە ڕۆ لەو درۆیە
نابێ کاکە لایبە
کورە ئەسڵەن
کۆمپانیاکان هین لێئەیەن ئەو کاتە ئێ تەندەری لەحنی جۆرا و جۆر
کورە کەرە، تۆ سەرە واوێ لە سکتا نییە، تۆ باسی چییەکەی
بزانێ ئێمە ئەوە خانوەکە ئەفرۆشین و ئیتر کوا
بێدەنگبە هەی قەشمەری خوێری
نانا دەس ئەکەین بە خەیار خواردن، خەیار خواردن ئەی
منی بینیووە وەکو پشیلە خۆی مات داوە
ئەیەم بەناوی شڵپی دەمتا
یەعنی هەر یەکجار هاتووە بۆ ماڵی ئێوە
بەڕاستی ماوەیەکە قسەکان هەمووی نیە پڕ لە موفاجەئەو هەمووی سوپرایزە سوپرایز
جەمال کوڕە دەبڕۆ
دەنی خۆمان بەین بۆ ئەوەی توشی ئەمە نەبین
تۆ بۆ بە کێشەی خەڵکەوە خەفەتەخۆی
چۆن یەعنی ئەوە زۆرە ئاخر بۆ خاتری خوا
فەحسەکانی شکور زۆر باشە
ئەگەر تۆ بتەوێ بە دوای سیحەتی باشا بگەڕێی بڕۆ گژو گیا بخۆ
باشە ببب تۆ تێیکە، ئیتر بێ قەزابی یاخوا هەرلەخۆتەوە
نەرمین گیان چۆن دڵم نایە ئەو ڕۆژە سەیرم ئەکرد زووڕە زووڕ
ئاروەڵا، وەڵا یەک قومار ئەزانێ پیاو نیە لێی بەرێتەوە
هیوا، بەڵێ بینەرانی بەڕێز و خۆشەویست شەوتان باش، هاتینەوە خزمەتان
مەهێڵە بیخە ئەو پەنایەوە
ئەمە فێرە بڵێشە
ئای مستەر چیمان ڕستبوو، بۆیان کردینەوە بە خوری
باشە سەیارەیا یاویەتی بە لای منە سەیارەیا یاویەتی بەلای منە ئەڵێ بۆچی وا سەریع ئەڕۆی ئەو ئیلاقەی سەیارەی منی چیە ئیلاقەی ماڵ و مناڵی منی چیە
شتی خوشکەزاکان ئەشکێنی ها
ئەڵێم نەکا، نەکا، ئەه ، خوانەکردە خۆی بکا بەلای ئێوەشا "تف"
ههه ئەی ئافەرم
هەتیو ئێوە زۆر سەیرن
فەرەیدوون کاک کەریم گیان
لە دەرگا بات و من جوێم لێی نەبێت
پەیوەندی، بەرنامەکەنان تا بلێ جوانە
حوکمەتەکەی خۆمانە حوکمەتی پەتریپۆت
ئا بەڵێ جا بۆ وەڵامی ئەم پرسیارە یێمەوە خزمەتت
کە گەورەترین هۆڵیان بۆ بکەمەوە
ئا، ئا وا ئەگەمە ئەوێ
بچێ، ئەها وەڵاهی هەر لە خۆو جوانە عەلی
ئەو خوێڕییە
نا نا ناتوانم گرتنەوەم هەیە و مەژغوڵم
ئەگەر وانەکەی ڕۆڵە ڕەوڕەوەی ژیانمان بەرەو دواوە ئەڕوات و
هین بوو، بۆسە چێ ئەو ئێ کورە هین
وە ئیتر ئاوایە، بڵێم چی حەزمەکرد شتتان دەسکەوێ
ئینجا با
ئەوە کەرێتیەکەی دەست پێکردەوانێ
هەی کەر چۆن شتیوا قۆڕ ئەکەی چۆن لەخۆتەوە فیل ئەجووڵێنێ
بەڵێ بەڵێ تەواو
موهیم ئەوەیە ئەوانە لێمان ڕازی بن
ئەونە سوراین و گەراین ئاخ ئا ئەییرۆ کەزال
بەشێکە من تەلەفوونەکەم، بەشێکە من
بۆ
ئێ عەزی دەرەوە ئەگەر شتێکی جوان بێت ناسک بێت
دەڕێ کەون ڕێکەون ئاقڵ ئەوەنەتان بەین نی یە
نەفەقێکی نشت و نوێ، گڵۆپەکانی لە مۆلیدە بەستراوە
فەرقێک هەیە من خۆم نیە، من خۆم ئەو فەرقەم دۆزیوەتەوە
مناڵێک نەبێ قەڵەمێچی قەڵەم قەڵەم، قەڵەمێچی پێبی بیکە بە ملی یەچێچی وەکو کوڕی منا
چۆن حەقیان چییە، دێنن و ئائێرەش ئەتەقێننەوە
شنە دەی فەرموو بەخێڕبێن یاخوا سەرچاو فەرموون
حەزمان کرد لەگەڵمانا بێیت و جەوەکە بگۆڕین
کوڕە ئەوەتا ئەها قاچیشم هەڵبڕیوە ئۆف براڕۆ ئۆف براڕۆ براڕۆ براڕۆ
ڕەحمەت لێ بێ، ئەمە مەعامەلەی پیاوە
دەستان خۆش بێ، خوا بۆتان بنووسێ
تا چێژتێکی بەلەزەتر و چاوپێکەوتنێکی تر دانیشن بە خێر
ئا، ئا ئاوا مەکە
ئێسا یەت و تشششتەکە، حەحەلەحەلەحەلە کەین
جا ئەوە ئەقڵە قومار خانە ئی ئەوەیە تەنسیقی لەگەڵا بکەیت و
وس، نێرگەلە بە دەمتانەوە بە شەکر بێ هەستن
دەی با هەر بڕوا
بەشەڕفم ناهێڵم زەرەکەی بە بیست مسقاڵ تەقەشی لێ هەڵەستنێم
وەلای کەشف بوو کێ
کوبرا چیی بکەم
ئنجا ئەزانی چی بکە
وەکو ڕۆیشتبوو مەوزوع دامەزرابوو و چی و ئەمانەو وتبوی
ئێمە وەختی خۆی هەر لە ڕە ڕەوەکەوانێ تۆزێ دۆستایەتیمان هەیە
سێ عەیار
هەر هاواری ئەکرد کاکم زۆر بەبەزەییە بۆ تەیر و تیور و باڵندە
یا هلا ابو شبیک
انی هسی احچی
ئەوە قسەیە تۆ کردھ ها
ئاها، تێتان ئەگەیەنم چونکە ئەمە ئێستە لە کەفائا ئیمتیحانتان ئەکەم
واو لێکەم حەیا و شەرفت ئەبەم و ناموستە شکێنم، بۆ ئەوەی
بەقوربانی خوا بم وەختێ من لەدەرەوە بووم ئا ئەمانەی کە تۆ ئەی بینی
خوایە بە قوربانی بەشبم
ئەڵێن عەقدی تەنکەرەکانی بۆ دەرچووە
نەختێ دەماغی خۆتی بۆ بسوتێنە
لوقمەکە ئەکەین بەدەمیەوە ئیتر چی دەوێ لەوە زیاتر
جوان دانیشە، خراپ دانیشتووی
ڵە ڵە ڵە ڵە ڵە دووکەڵ لەلوتتەوە یەتە دەرەوە
ئاشت خان گیان بەساقەوبم چاوی شیلان ماچەکەم
