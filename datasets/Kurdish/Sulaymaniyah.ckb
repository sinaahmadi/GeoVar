ئێ باشە هەر خۆشتان نەبوون وتتان ئەم کیسەڵە هێمای ئاقڵی و دانایی و ئەو شتانەیە
من بە حوسن و ڕەزای خۆم ئێرەم هەڵبژاردووە
جەنابت خۆ لە ماڵەوەی ئاگایەکت لەم بەر بێت
ئەوە ئەویارییەی کە ئەسوڕێتەوە، نازانم سکەتلمەوتە شتێکی وایە
بەیان جاران سوێن بۆ ئەخۆم
ئاخرهی جوانت دانابێ
دە بڕۆ، چیت چی بۆهاتووی بۆ ئێرە دە بڕۆ
فەوزایە، فەوزایە، ئەم سڵفەمان فەوزایە
ئا ئا، کوڕە حەکیم بەگ
دەباشە
دوای
تۆ یەک مەڕی هەشتا چیلۆیم بەرێ، مەمنونت ئەبم
نانا جارێ ئەوەنە موهتەم نیم پەی ئێ یاخوا بەخێربەیت
تۆ بڕۆ هەر بخەوە
هەی نەگبەت، نەچووی بۆلای وەسا شەوکەت
پش ئین
والله ئەچم بۆ ماڵی عارف
توخوا بۆ هێنای وەڵای عەزێتە کێشن، مەیەڵە بچێ بۆ دوکان و شت میوە ناخۆین
ئەی چۆن بچین
وەک چی بەساقەوبم
وش، ئەی باوکەڕۆ، ئەی باوکە، چییەکەن چیە ئەوە
نا مشکیلە نیە بۆی ئەبێت ئاگەر بۆیشی نەبوو ئەیهێنمەوە ئیحتیادیە وایە
حەر هەمووی کۆکەیتەوە لە شەو و ڕۆژێکا سێ سەعات نەنوستوە
ئەلحەمدوریلا
ئا من مریشکی هین ناخۆم مریشکی ئەمە ئەم مریشکانەی کە هەییە لە بازاڕ
ئەبێ ئاوا ئەو دڵەو بتەقێ، بۆنی کاکە مارف ناخۆشە
منش، وتم بەسەر چاو چووم بۆ لای سەرۆکی شارەوانی
ئەی ئەوە ئسڵوب و تەربێتە
باوکی چە زەحمەتێکی لەگەڵا کێشاوە، چۆن نازی یاوەتێ
بێ وەیە و
بۆ خاتری پێ کەس دەست نەکا بە کیسەی خاڵی
خۆ مستەر خۆ من خراپم نەوتوە، هەروەکو مراقیب وتم هاستن
مەوزوعەکەی گوڵندام هەر تەواو ناخۆش بووەو ئەوانە
ئەیتر لەو گۆزەیەوە، پێنا وتوە سوڵتان موسا
هەر بازرگانییە ئەزانی بۆچی تۆ داهات هەیە، هەر بازرگانیە
من ئەمەنە نا پیاو نیم وەکو عارف
پەتریپۆت
جیری خواردووە بە دەست جەنابتەوە، دەردی کاک ئەحمەد وتی
ئەھ ، ئەوە کاک لوقمانی عەینەک فرۆشە
ئینسانی موسەقەف حەزی لە شەڕ نیە، ئاشتی خۆشە
مصەوەری تر ئەهێنم، مصەوەری تر
ئەیبەین با ئەویش دوو عانەی دەس کەوێ
بەشەرەفم بە پیاسە زوتر ئەگەی بە پیاسە
جەمیل ئەوە تۆ بە ڤیدێۆ تەسویری دەکەی ، ها
تۆ ئەم کوڕە قۆزە ناناسیتەوە
چەنەبازییی لێینایەیت
ماشەڵااا ماشەڵا ماشەڵا لە تۆ کە دڵ سۆزی یاعنی تۆ دڵ سۆزی منی
ئاا ئەگەر تۆ دەست بڕوا
بەخوا باوەڕناکەم، چونکە پیاو نین
هیچ شتێچیکە نییە
بەخوا پێشی عەیب بوو قسە بکا ، بەڵام پێم وت چەنی ترتەوێ ئەت دەمێ
خۆش بن یاخوا، فەرموون
مواقف
ئەلۆۆ
قۆڵن پاو
چای جوانمان بۆ بێنە
یان هەر
وەاللەهی بڵێیم چی نازانم
هەموو شتێ باشە، بۆ ئەمنە حیمایە دوای خۆتەخەی
ئەمە چیە ئەمە وەزعە ئێمە تیاین
ئەم دراوسێیانەی خۆمان
هادی، خوایە لێ و بەزیا بێت بۆ ئەم سوڵتانە، خوایە لێ و بەزیا بێت خوایە لێ و بەزیا بێت
میستەر
دە پەلە مەکە کوڕە
ئاخر تۆ شایانی ڕێزی ئەزانی
کۆمەڵێک جلی ڕەنگاو ڕەنگی ناشیرین لە بەر ئەکا
وەلف
من نەبینی بە قەدەر یەک هەمەر ئەبم لێرەیا من نەبینی
وەڵاهی قوربان هەرچییەبم پەروەردەی دەسی جەنابتانم
هادی، وەلای چاک
ئەی چۆن لە دەوری سەری گەڕێم
تۆ چاو لێیە
تۆ لەسەر دەمی خۆت گیرای
تۆ زۆر سەیری
تۆ واز لەوە بێنە کاکە وەختی سەیارە نییە
دارین، کاکە ئەزانی چۆنە
هیچ هیچ نیە
لە ئاسایشا پەنێکمان پێ نایەی
نەخێر، کۆرسی سیاسین ئەوان
بۆم ڕەوانە کردی ناتوانم بەرەڵڵای کەم
حەزی لێ نییە
یەک دەقە با، بزانم جێیە
چی یێتەوە، نینۆکە بێتەوە، کەی یێتەوە پێم بڵێ
کە وای لێیە کە ئەچی بۆلای دکتۆر لەبری ئەوەی کەوا
کوڕە جوانەکانم، تەمەشای پیاوەتی و شەهامەتی جەنابتانەکەم
بێدەنگبننن
ئەی ئافەرم، ئا ئەم نەفرۆشتنەت زۆر زۆر موهیە، منیش ئەوەم پێباشە
عەول، نا دە جارێ هجوم مەکە عەمرت نەمێنێ ئەلێ تێ ئەگەی
تۆ داکی ئەو بیت بیست ژنیکە بێنی ئەبێ هەر ئاوا تەڵاقی با
پیرەمێردێکیان ئیهمال کرد
ئم، ئەو تۆزە ڕۆنەش مابوو کردم بە هێلکە و ڕۆن
سەیری ئەو پەنجانی کە ئەڵێی شمشاڵە
ئەی تەبعن بۆ
حەی حەی حەی حەی بەخوا جوانە
ئەها ڕاستە کا گەورەم هەر بۆیە لە ماڵیشەوە لەگەڵ خێزانەکەیا
تەیموور، ئەدحاد
ئەمە چیتە کاکە تۆ
وەڵاهی ئەم بەیانیە برسیمە نازانم چی بخۆم
باا
لە ڕانیەش قسمی داخلیمان هەیە
یانی هیچ مەنتقی تیا نییە ئەم بیست و پێنج هەزار وەرگرێ و
دە وەرە دەی، بەس پێبکەنە
هەورە گرمە نیشانەی وشکە ساڵیە
شەرت نییە شاعیر کە شیعرێ ئەنوسێ مەبەستی کەسێکی دیاریکراو بێ
گێی ڕاستی لێبۆتەوە، پەردەی تەقیوە
ئەمرکە ئەمرکە
یاخوا داوەشێ قارەمان بڵێ ژن ئەهێنم بە هەوەس
لەبن تایەی سەیارە و لەبن تەنکی بەرمیل و ئەمانە شەو و ڕۆژ ئەکەن
دەمێکە جوێمان پڕبووە لەو درۆ و دەلەسانە
وشەی بوو
حەتمەن لەوە ئەچێ ئا ئەمەبێت
ئێ وایە ئەی پێم نەوتی (ناڕونە)
قوزەڵقورت ئەکا وا ئەزانێ ئەمرۆ بەس دەرس بەم ئەڵێنەوە، تۆ
کە چوویتەوە بە دایکت بڵێ
توڕەیە تورەیە زۆر توڕەیە
ڕاوەسە، تۆ سەیری ئا ئەمە کە، ئەڵێی تووتیە، ها ها، ها، بخۆ بخۆ
هیلاک ناکەم
ئەوەش قادرمەکە بوو کە ئێستا بە پلەکانا سەرکەوتین
گەنجیش نییە، بەخوا جاریوا هەیە کابرا کامڵەو لە هەموو
بڕۆ زەهتوتی چاوچنۆکی چڵکن
نەوەو شەش چواری مابوو چواری مابوو لە پڕ
تو غیرەت، تو، تو حەیسیەت
بۆ براژن قەلەموونی وا چییە تاکو لجووئی بەنێ ها
بۆچی مەسەلە ئەم نەزافەتە ئەبێ هەبێ بەڕاستی ئێمە
خاتوونانمان ئێ، عەفو ئەوەم لێ تێکچوو بەبێ جیاوازی
ئەرێ بوەستە کاکە بوەستە
کوا بەرنامەکەو کوا
منیش خەریکەسوێمە بێتۆ بۆ تۆزێ ئاو، هەی ڕەق و تەقی ناشیرین
وەک پێم وتی
شەش حەوت گۆشەی تێگرتم
حەساینەوە
فەرق نەئەما تێیەگەی هەمووی بە چوار مشقیەوە دەوامیە کرد کورسی نەبوو شت نەبوو
دەستان خۆش بێ، بەس هیوادارین زوو بە زوو
نا ماقوڵ فەرموو قەڵتاخ ئێمە و ڕەشی بەگ
کاک ئەحمەیش هەر عەینەن شت، چونکە براژن ئەوە
ئئ، ببورە مستەر جیان ئەمن ناتانم قسە لەو مەوزوعەی بکەم
نا نا، شاگردی تەشکیلی بوە لێی ئەزانێ
حەتمەن حەتمەن کوڕم، دایکی خۆت وا ئەناسی بەسەرچاو
ئەڵێم ڕەفیقی ئێمە ئێستا لە سێیەم پێکەیا
وەڵا حەقی گلەیت هەیە جەزا ئەبوو یەکەم کەس هەر خۆم بهاتمایە
من ناوی شوێنەکە ناڵێم
یەعنی بەشیشتان هەیە، بۆ لێکۆڵینەوە لە خەون و خەیاڵ
ئا تەواوە
وەرە کابرا ئەم هەموو پارەو هەبێ لەماڵ و مناڵەکەت بشاریتەوانێ و نەزانی بیخۆی
کاکە جیان، ئەم جارە زەحمەت نەبێ لێی یەرەوە
وەکو وایە ئێمە زۆر تاقەتمان هەبێ و ئەمانە
جەمال بەرێوەلا
بەس نەیان هێشتووە لە کۆنەکەی دەرچێ
کێ خۆلەو کێ ئەزانی چی من پێم وایە واش بۆی ئەچم
بە قەومەی دارێکا هەڵواسیووە
دایکی مناڵەکانیش ئەڵێ پەڵپینە وەک و تۆڵەگە واییە ئەمەنە زۆرە
ئاخ ناتەقێ نااا
دزیە کەی
خەمت نەبێت ڕەشی بەگ خەم نەبێ
ئەیانوو تەڕە توولەکەی
ئەم قسانەی ئەم بەڕێزە ئەیکە هیچی مەنطق نییە مەنطق نییە
ئا ئا بەتایبەتی ئەگەر دوژمن لێیبا
بەخوا هەر بەبای خەیاڵیشیا نایە
نا نا ئیسراحەتی خەوتی
نایەمە لای کەستان هیچ نایەم
من ژنی ئەو بومایە وەڵاهی وەبیلاهی تەڵاقی خۆمم لێ وەرەگرت
تەیموور، چی ئەکەی چی ناکەی ئەوها بکە چاک ئەبێ ئاوا بکە نەتیجەی ئەبێ
چەنە بازی مەکە، کابرا کلاراوی کردووە ئاگر باسی ئەکا، ها
ئەمە ئەڵی چی، ئەڵێ وەڵا کاکە من ئەفکالام چۆنە
ئەبێ ئەئاوا دەسە وسان لەماڵەوە دانیشێ و کاسپی نەکی
بە شەرەفم چاویان بەم وڵاتە هەڵنایێت، بۆیە
حەمە گیان بەخوا ئەم شەڕەم بە دڵ نیە ڕۆڵە
ئەوە چییە ئەو دەنە دەنگە گوڵە
ئەه ، مامەگیان
ئەمە گۆرانیە…
نەء، بۆ نمونە خوانە خواستە ئەڵێم
چاو نەترسم، چاو نەترس یەعنی
یانی خانووەکە وەرەسەیە
ئەرێ مەیکوژێنەرەوە بابە گیان تۆزێکیکە ئیخبارە
کورە ئاخر مڕاقیب چۆن شتی وا ئەبێ کاکە گیان
بێ قیمەتە بچم هەزار شەقی تێهەڵەم و گوی دەرخواربەم، هاا
هەر لێرە ڕۆشتم دوای کەو تووم دوای کەووتم
تۆ نەوبیستووە هەی ئەلبێریکامۆ و کاڵکاو و ساکتەر
ئێوارەش کە هاتیتەوە، بمبە بۆ عەیادەیەک
ئێ باش بوو باش بوو، بە بەهۆی تۆوە ئاوا ئیشەکە بەڕێک و پێکی ڕۆیشت
کاک عەول هەستە پێشم کەوە
ئەمە پیاوەتیم لەگەڵ باوکیانا کردووە
من خۆم پێم نە وتی شۆرتی تیایە
ڕۆڵە تۆ ئەبێ بە ختوات بۆی بچی، وایە کاکە، بە گەورەو بچوکی نییە
بێڵە ئیشەکەم کەم، ئاخر تۆ ئاوا بە قسەوە مەشغووڵم بکەیت
ئەڵێم تاقمەکی میوانم بۆ ئەکڕی
لە نێوان مرۆڤەکاندا بوونی هەبێت بەڵکو لە نێوان ئاژەڵەکاندا زیاترو
ئافەرم ڕاست ئەکا، بەسمە بەعەرەبی یاعنی زەردەخەنە ئەی باشە
بەسەرچاو خواحافیزتان بێت
خۆتەزانی شوێنەکەی من تۆژێ گەورەترە وایە
پێی ئەڵێم ئەوەتا پێی ئەڵێم
ماهیر ئەلا سەیر سەیر نوری بەجدی ئەمانە هەمووی کەسایەتین هەر یەکە بۆ خۆی داهێنانێکی کردووە
بینەرانی بینەرانی بەڕێز و خۆشەویست ئێمە ئێستا
باوەشەیەوەیانێ ئەو مەمکەی ئەیاتێ
برادەر زۆرە خۆ پارەم بەنێ بەس ئەوە نییە ئێستا لەوە ئەچێ بڵێ
نە ئەوانش بڵێم ڕەحمەتی پارەکەی پێ بوو
تێگەشتی ئێستا مەسەلەن تۆ لەوانەیە بەم حیسابەی خۆو کوڕەکەو ئێستا دەربچێ لەوانەیە بچی دەمانچەیەچی هینی بۆ بکڕی بۆوەی فێربێ
ئەرێوەڵاه
پەیوەند بکە بەژو، بە ژوری ڵێکۆڵینەوەوە
لەوە بوو ئەڵێ ئەو ڕۆژەی کە ئێمە ڕۆشتین بۆ سەیران
مەعڕوف کوڕە حەیامان ئەچێ قالە جیان لەگەڕەکا
بەڕێزان ئەوەی کە باسم کرد ئەمە پارەیە دراو، مەنی، فلوس، سکە
ئێ دە زۆر باشە دە بڕۆ شیلان
ها، موقڕایت داهاتووە
من ئەوە برای خۆمە، باشی ئەناسم ئێسە ئەو ناڕەسەنە
کەتان، سوڵتان جیان ئەڵێم بۆ بیرێکمان لێ ناکەیتەوە
باشە باشە باشە ئادەی ئێ ئێ ئێ هاهە ئێ ئێ یاعقوبە فەنی
بینەرانی بەڕێز و خۆشەویست گوێتان لێیە ئەم هەموو
گەورەمی چی عەمر نەمینێ ئێستا من ئەم هەموو شتە بارکەم و دایگرمەوە
سوڵتان، ئەو قسانە چییە
ئا، ئا ئێستا گەیشتم
برواتەوە بڵێ بڵێ شت تەوزیع ئەکەن
ئێ ، ئەها سەرکەوتووە بن
کەی ئەوانە ڕەفیقە تۆ هەتن
نەهاتووە، تێ ئەگەی بە تەمام ئەزانی چی بکەم کاکە جیان
نانا بە قوربان بم ئەوە عەیبە، عەیبە پیاو جۆن شتی وا ئەکا
یاخوا عەمر درێژ بی
پێکەنین
دە بەسەری حەر سێکتان دێیەک هەیە یٔا یٔەلەوێیا
خەفەت لە دڵما نەماوە ئەمە هاتووە من
من دەھ گولەی دی تەقاندبانا
نوری بەس ئەم قاتی لە بەرە
ئەزانی چۆن ئاواز ئەوە عەینەن مدیرەکەی ئێمەش وایە
بانیۆ
پیاوێکی هەتا بڵێی شەهم، لەبەرئەوە دڵی خۆتان گران مەکەن
ڕەعنە کولی کەرەتێک کە ئەو گڵۆژە سور ئەبێت
هەر وتم بابچم سەرێکی لێیەم خۆ ئیشیشم نەبو وەڵا
یەک تێی تەقاند تێی تەقاند، ڕایکردە دەرەوە
یٔێ چوێرایم دایە پۆلیسی وڵاتان بە یٔەلی کۆپتەر یٔەچن
